/* GENERATED by tools/gen_tokens.py — theme: hpgray */
QWidget { background: #C4C4C4; color: #202020; }
QFrame#Chrome, QFrame#Panel { background: #BCBCBC; border: 1px solid #656565; }
QLabel#Dim { color: #414141; }
QLabel#Faint { color: #494949; }
QLineEdit, QSpinBox, QDoubleSpinBox { background: #E0E0E0; border: 1px solid #245A86; }
QLineEdit[readOnly="true"] { border: 1px solid #898989; color: #414141; }
QPushButton { background: #ADADAD; border: 1px solid #656565; }
QPushButton[selected="true"] { background: #245A86; color: #E0E0E0; }
QPushButton:disabled { color: #494949; }
