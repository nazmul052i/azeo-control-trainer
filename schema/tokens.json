  "invariant": {
    "$comment": "State roles are theme-invariant on purpose: one meaning, one colour, every theme. Their *_TEXT companions are not, and cannot be — a fill colour is read against a mark's outline, but text is read against the panel behind it, and no single hue clears both a light panel and a dark one. ALARM_P3 sits 0.9 of luminance from the HP-gray panel; ALARM_P1 sits 15 from the dark one. Marks keep the invariant colour; text takes the companion.",
    "ALARM_P1": "#C4262E",
    "ALARM_P2": "#E08A1E",
    "ALARM_P3": "#E3D02A",
    "ALARM_SHELVED": "#9AA0A6",
