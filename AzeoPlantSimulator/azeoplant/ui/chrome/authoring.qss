/* Generated by tools/export_simulator_chrome.py */


QMainWindow, QDialog { background: #ECEEEF; }
QWidget#engineering_pane { background: #FFFFFF; }
QMenuBar { background: #004487; color: #FFFFFF; padding: 1px 5px;
    border-bottom: 1px solid #163F69; font-size: 9pt; }
QMenuBar::item { padding: 6px 11px; background: transparent;
    border-bottom: 2px solid transparent; }
QMenuBar::item:selected { background: #285F9A;
    color: #FFFFFF; border-bottom-color: #CFE3F5; }
QMenuBar::item:pressed { background: #163F69;
    color: #FFFFFF; border-bottom-color: #FFFFFF; }
QStatusBar { background: #F5F6F7; color: #5A6168;
    border-top: 1px solid #D8DADC; font-size: 9pt; }
QStatusBar::item { border: none; }
QToolBar { background: #FFFFFF; border: none;
    border-bottom: 1px solid #D8DADC; padding: 4px 6px; spacing: 2px; }
QToolButton, QPushButton { background: #FFFFFF; color: #2B323B;
    border: 1px solid #E1E5EA; border-radius: 4px; padding: 5px 8px; }
QToolButton:hover, QPushButton:hover { background: #E3EEF7; border-color: #004487; }
QToolButton:checked, QPushButton:checked { background: #CFE3F5; border-color: #004487; }
QToolButton:focus, QPushButton:focus { border-color: #004487; }
QToolButton:disabled, QPushButton:disabled { color: #9AA5B4; }
QLineEdit, QAbstractSpinBox, QComboBox { background: #FFFFFF; color: #2B323B;
    border: 1px solid #D8DADC; border-radius: 4px; padding: 4px 7px;
    min-height: 20px; }
QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border-color: #004487; }
QAbstractSpinBox QLineEdit, QComboBox QLineEdit {
    border: none; padding: 0; min-height: 0; background: transparent; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    background: #F5F6F7; color: #9AA5B4; }
QComboBox QAbstractItemView { background: #FFFFFF; color: #2B323B;
    border: 1px solid #D8DADC; selection-background-color: #CFE3F5;
    selection-color: #004487; outline: none; }
QTreeWidget, QTreeView, QTableWidget, QListWidget { background: #FFFFFF;
    alternate-background-color: #F5F6F7; color: #2B323B;
    border: none; outline: none; }
QTreeView::item { min-height: 24px; padding: 2px 5px; }
QTreeView::item:hover, QTableView::item:hover, QListView::item:hover { background: #E3EEF7; }
QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background: #CFE3F5; color: #004487; }
QHeaderView::section { background: #F5F6F7; color: #5A6168;
    border: none; border-bottom: 1px solid #D8DADC;
    border-right: 1px solid #E1E5EA; padding: 5px 8px; font-weight: 600; }
QTabWidget::pane { background: #FFFFFF; border: none; }
QTabBar::tab { background: #F5F6F7; color: #5A6168;
    border: none; border-bottom: 2px solid transparent; padding: 5px 10px; font-size: 9pt; }
QTabBar::tab:hover { background: #E3EEF7; color: #004487; }
QTabBar::tab:selected { background: #FFFFFF; color: #004487;
    border-bottom-color: #004487; font-weight: 600; }
QSplitter::handle { background: #E1E5EA; }
QSplitter::handle:hover { background: #004487; }
QScrollArea { border: none; }
QToolTip { background: #FFFFFF; color: #2B323B; border: 1px solid #D8DADC; padding: 6px; }

QWidget { selection-background-color: #004487;
           selection-color: white; }
QCheckBox { spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px;
    border: 1px solid #9AA5B4; border-radius: 3px; background: #FFFFFF; }
QCheckBox::indicator:hover, QCheckBox::indicator:focus {
    border-color: #004487; background: #E3EEF7; }
QCheckBox::indicator:checked, QCheckBox::indicator:indeterminate {
    border-color: #004487; background: #004487; }
QCheckBox::indicator:checked { image: url("@ASSETS@/check.svg"); }
QCheckBox::indicator:indeterminate { image: url("@ASSETS@/indeterminate.svg"); }
QCheckBox::indicator:disabled { border-color: #D8DADC; background: #F5F6F7; }
QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled { background: #9AA5B4; }

QLineEdit, QComboBox, QAbstractSpinBox { background: #FFFFFF; border: 1px solid #CBD2DA;
    border-radius: 6px; padding: 5px 10px; min-height: 20px; selection-color: white; }
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: #809AB5; }
QLineEdit:focus, QComboBox:focus, QComboBox:on, QAbstractSpinBox:focus { border-color: #004487; }
QComboBox { padding-right: 34px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 32px; border: none; border-top-right-radius: 6px; border-bottom-right-radius: 6px;
    background: transparent; }
QComboBox::drop-down:hover { background: #E3EEF7; }
QComboBox::down-arrow { image: url("@ASSETS@/chevron-down.svg"); width: 16px; height: 16px; }
QComboBox::down-arrow:on { image: url("@ASSETS@/chevron-up.svg"); }
QComboBox QAbstractItemView { background: #FFFFFF; border: none; padding: 4px;
    selection-background-color: #CFE3F5; selection-color: #004487; outline: none; }
QComboBox QAbstractItemView::item { min-height: 20px; padding: 4px 10px;
    border-radius: 4px; margin: 1px 0; }
QComboBox QAbstractItemView::item:hover { background: #E3EEF7; }
QAbstractSpinBox { padding-right: 28px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border;
    subcontrol-position: top right; width: 26px; border: none; border-top-right-radius: 6px;
    background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border;
    subcontrol-position: bottom right; width: 26px; border: none; border-bottom-right-radius: 6px;
    background: transparent; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #E3EEF7; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("@ASSETS@/chevron-up.svg"); width: 12px; height: 12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("@ASSETS@/chevron-down.svg"); width: 12px; height: 12px; }
QAbstractSpinBox QLineEdit, QComboBox QLineEdit { border: none; padding: 0; min-height: 0; }
QPlainTextEdit { background: #FFFFFF; color: #2B323B;
    border: 1px solid #CBD2DA; border-radius: 6px; padding: 5px; }
QPlainTextEdit:focus { border-color: #004487; }
